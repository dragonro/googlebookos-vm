#
# French (Mac) key character map for the Googlebook VM.
# Character layers match macOS com.apple.keylayout.French. The scan-code
# remaps follow AOSP's French AZERTY layout.

type OVERLAY

map key 16 A
map key 17 Z
map key 30 Q
map key 39 M
map key 44 W
map key 50 COMMA
map key 51 SEMICOLON
map key 86 PLUS


key GRAVE {
    label:                               '<'
    base:                                '<'
    shift:                               '>'
    alt:                                 '\u2264'
    shift+alt:                           '\u2265'
    ctrl, meta:                         none
}


key 1 {
    label:                               '&'
    base:                                '&'
    shift:                               '1'
    alt:                                 '\uf8ff'
    shift+alt:                           '\u0301'
    ctrl, meta:                         none
}


key 2 {
    label:                               '\u00e9'
    base:                                '\u00e9'
    shift:                               '2'
    capslock:                            '\u00c9'
    alt:                                 '\u00eb'
    shift+alt:                           '\u201e'
    ctrl, meta:                         none
}


key 3 {
    label:                               '\"'
    base:                                '\"'
    shift:                               '3'
    alt:                                 '\u201c'
    shift+alt:                           '\u201d'
    ctrl, meta:                         none
}


key 4 {
