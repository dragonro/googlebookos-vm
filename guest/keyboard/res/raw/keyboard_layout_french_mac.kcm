    shift:                               '5'
    alt:                                 '{'
    shift+alt:                           '['
    ctrl, meta:                         none
}


key 6 {
    label:                               '\u00a7'
    base:                                '\u00a7'
    shift:                               '6'
    alt:                                 '\u00b6'
    shift+alt:                           '\u00e5'
    ctrl, meta:                         none
}


key 7 {
    label:                               '\u00e8'
    base:                                '\u00e8'
    shift:                               '7'
    capslock:                            '\u00c8'
    alt:                                 '\u00ab'
    shift+alt:                           '\u00bb'
    ctrl, meta:                         none
}


key 8 {
    label:                               '!'
    base:                                '!'
    shift:                               '8'
    alt:                                 '\u00a1'
    shift+alt:                           '\u00db'
    ctrl, meta:                         none
}


key 9 {
    label:                               '\u00e7'
    base:                                '\u00e7'
    shift:                               '9'
    capslock:                            '\u00c7'
    alt:                                 '\u00c7'
    shift+alt:                           '\u00c1'
    ctrl, meta:                         none
}


key 0 {
    label:                               '\u00e0'
    base:                                '\u00e0'
