key COMMA {
    label:                               ','
    base:                                ','
    shift:                               '?'
    alt:                                 '\u221e'
    shift+alt:                           '\u00bf'
    ctrl, meta:                         none
}


key SEMICOLON {
    label:                               ';'
    base:                                ';'
    shift:                               '.'
    alt:                                 '\u2026'
    shift+alt:                           '\u2022'
    ctrl, meta:                         none
}


key PERIOD {
    label:                               ':'
    base:                                ':'
    shift:                               '/'
    alt:                                 '\u00f7'
    shift+alt:                           '\\'
    ctrl, meta:                         none
}


key SLASH {
    label:                               '='
    base:                                '='
    shift:                               '+'
    alt:                                 '\u2260'
    shift+alt:                           '\u00b1'
    ctrl, meta:                         none
}


key NUMPAD_DOT {
    label, number:                       ','
    base:                                ','
    shift:                               '.'
    alt:                                 ','
    shift+alt:                           '.'
    ctrl, meta:                         none
}
